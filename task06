#include <stdio.h>
#include <string.h>
#define MAXL 30

void sort_names(char names[][MAXL], int n, long *cmpCount)
{
    *cmpCount = 0; char tmp[MAXL];
    for (int i = 0; i < n - 1; i++)
        for (int j = 0; j < n - 1 - i; j++) {
            (*cmpCount)++;
            if (strcmp(names[j], names[j+1]) > 0) {
                strcpy(tmp, names[j]);
                strcpy(names[j], names[j+1]);
                strcpy(names[j+1], tmp);
            }
        }
}
int binary_search_names(char names[][MAXL], int n, const char *key, long *cmp)
{
    int low=0, high=n-1; *cmp=0;
    while(low<=high){
        int mid=low+(high-low)/2; (*cmp)++;
        int c=strcmp(names[mid],key);
        if(c==0) return mid;
        else if(c<0) low=mid+1;
        else high=mid-1;
    }
    return -1;
}
int main(void)
{
    char names[][MAXL]={"Zara","arun","Meera","arun","Kiran","meera","Asha","Ravi"};
    int n=8; long cmp=0;
    sort_names(names,n,&cmp);
    for(int i=0;i<n;i++) printf("%s\n",names[i]);
    printf("Duplicates:\n");
    for(int i=1;i<n;i++)
        if(strcmp(names[i],names[i-1])==0)
            printf("%s at %d and %d\n",names[i],i-1,i);
    long sc; 
    printf("Ravi -> %d\n",binary_search_names(names,n,"Ravi",&sc));
    printf("John -> %d\n",binary_search_names(names,n,"John",&sc));
    return 0;
}
